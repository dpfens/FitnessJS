{
  "name": "fitnessjs",
  "version": "3.0.0",
  "description": "Exercise physiology equations",
  "license": "Apache-2.0",
  "author": "Doug Fenstermacher",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/bundle/index.umd.min.js",
  "jsdelivr": "./dist/bundle/index.umd.min.js",
  "browser": "./dist/bundle/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./anthropometry": {
      "types": "./dist/types/anthropometry/index.d.ts",
      "import": "./dist/esm/anthropometry/index.js",
      "require": "./dist/cjs/anthropometry/index.js"
    },
    "./cardiovascular": {
      "types": "./dist/types/cardiovascular/index.d.ts",
      "import": "./dist/esm/cardiovascular/index.js",
      "require": "./dist/cjs/cardiovascular/index.js"
    },
    "./composition": {
      "types": "./dist/types/composition/index.d.ts",
      "import": "./dist/esm/composition/index.js",
      "require": "./dist/cjs/composition/index.js"
    },
    "./conversion": {
      "types": "./dist/types/conversion/index.d.ts",
      "import": "./dist/esm/conversion/index.js",
      "require": "./dist/cjs/conversion/index.js"
    },
    "./models": {
      "types": "./dist/types/models/index.d.ts",
      "import": "./dist/esm/models/index.js",
      "require": "./dist/cjs/models/index.js"
    },
    "./sport": {
      "types": "./dist/types/sport/index.d.ts",
      "import": "./dist/esm/sport/index.js",
      "require": "./dist/cjs/sport/index.js"
    },
    "./strength": {
      "types": "./dist/types/strength/index.d.ts",
      "import": "./dist/esm/strength/index.js",
      "require": "./dist/cjs/strength/index.js"
    },
    "./utilities": {
      "types": "./dist/types/utilities/index.d.ts",
      "import": "./dist/esm/utilities/index.js",
      "require": "./dist/cjs/utilities/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "anthropometry": [
        "./dist/types/anthropometry/index.d.ts"
      ],
      "cardiovascular": [
        "./dist/types/cardiovascular/index.d.ts"
      ],
      "composition": [
        "./dist/types/composition/index.d.ts"
      ],
      "conversion": [
        "./dist/types/conversion/index.d.ts"
      ],
      "models": [
        "./dist/types/models/index.d.ts"
      ],
      "sport": [
        "./dist/types/sport/index.d.ts"
      ],
      "strength": [
        "./dist/types/strength/index.d.ts"
      ],
      "utilities": [
        "./dist/types/utilities/index.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:all",
    "build:all": "npm run build:unbundled && npm run build:bundle",
    "build:unbundled": "npm run build:esm && npm run build:cjs",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node scripts/mark-cjs.mjs",
    "build:bundle": "rollup -c rollup.config.mjs",
    "prepare": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "rimraf": "^6.0.1",
    "rollup": "^4.25.0",
    "rollup-plugin-dts": "^6.1.1",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3"
  }
}
